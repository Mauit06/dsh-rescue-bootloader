{
  "name": "dsh-rescue-bootloader",
  "version": "1.0.0",
  "description": "DSH 救砖模块 — 崩溃检测、两级安全模式、救砖管理台一体化插件。类似 Windows 安全模式 / Magisk 救砖。",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "dsh-rescue.ps1",
    "rescue-server.mjs",
    "rescue-ui.html",
    "install.ps1",
    "uninstall.ps1",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "cordis",
    "plugin",
    "rescue",
    "safe-mode",
    "bootloader",
    "recovery",
    "crash-detection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mauit06/dsh-rescue-bootloader.git"
  },
  "homepage": "https://github.com/Mauit06/dsh-rescue-bootloader#readme",
  "bugs": {
    "url": "https://github.com/Mauit06/dsh-rescue-bootloader/issues"
  },
  "license": "MIT"
}
